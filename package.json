{
  "name": "card-press",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "scripts": {
    "generate": "./scripts/generate-assets.sh",
    "dev": "bun run generate && bun --hot src/index.tsx",
    "build": "bun run generate && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --splitting --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.tsx",
    "test": "bun test",
    "lint": "bun run generate && eslint src test && prettier --check src test",
    "lint:fix": "bun run generate && eslint src test --fix && prettier --write src test",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "drop-in-css": "^0.1.9",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pica": "^10.0.3",
    "react": "^19",
    "react-dom": "^19",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gl-matrix": "^3.4.4",
    "globals": "^17.1.0",
    "jiti": "^2.6.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.54.0"
  }
}
